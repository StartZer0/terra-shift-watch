# Copy to .env. Never commit real credentials. Only VITE_ values enter the browser.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_REASONING_MODEL=muse-wonder-1.0
META_REASONING_EFFORT=max
META_SEGMENTATION_MODEL=sam-3.1
META_ALLOW_MODEL_FALLBACK=false
# Only a restricted PUBLIC Cesium read/geocode token belongs here.
VITE_CESIUM_ION_TOKEN=

# Optional authenticated data reads; public weather/catalog checks need no key.
EARTHDATA_TOKEN=
EWDS_API_URL=https://ewds.climate.copernicus.eu/api
EWDS_API_KEY=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
WATCH_MAX_AREAS=12
# Local persistent estimated-spend ledger, not an account-wide balance.
META_SESSION_BUDGET_USD=15

# Historical analysis at /history
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
ANALYSIS_IDLE_TTL_MINUTES=60
ANALYSIS_MAX_LIFETIME_MINUTES=240
WORKER_RSS_CEILING_MIB=1024
GDAL_CACHEMAX=128
GDAL_NUM_THREADS=1
VSI_CACHE=FALSE
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
APP_HOST=127.0.0.1
