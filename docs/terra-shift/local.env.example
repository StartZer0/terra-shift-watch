# Template only. Configure actual values in the workspace root .env, never here.
# Runtime Meta API (server only)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_REASONING_MODEL=muse-wonder-1.0
META_SEGMENTATION_MODEL=sam-3.1
# Muse Code headless auth, if not using local browser sign-in
META_API_KEY=
# Only a restricted PUBLIC read/geocode token may use the VITE_ prefix.
VITE_CESIUM_ION_TOKEN=
# Public catalogs and weather do not initially need an application API key.
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
SENTINEL_COLLECTION=sentinel-2-l2a
LANDSAT_COLLECTION=landsat-c2-l2
DEFAULT_HISTORY_SOURCE=landsat-c2-l2
WEATHER_DATASET=era5
# Proposed operational limits. Implementation must enforce them server-side.
ANALYSIS_IDLE_TTL_MINUTES=60
ANALYSIS_MAX_LIFETIME_MINUTES=240
ANALYSIS_MAX_CONCURRENT_JOBS=1
META_SESSION_BUDGET_USD=150

# Initial laptop-friendly proposals, not measured guarantees.
# Implement enforcement/monitoring; config names alone impose no limits.
RASTER_BLOCK_SIZE=512
GDAL_CACHEMAX=128
GDAL_NUM_THREADS=1
VSI_CACHE=FALSE
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
ASSET_READ_CONCURRENCY=2
SAM_REQUEST_CONCURRENCY=2
WORKER_RSS_CEILING_MIB=1024
WARP_MEMORY_MIB=64
TEMP_JOB_QUOTA_MIB=2048
HOST_FREE_DISK_RESERVE_MIB=2048
ANALYSIS_PREVIEW_MAX_EDGE=2048

META_REASONING_EFFORT=max

META_ALLOW_MODEL_FALLBACK=false

APP_HOST=127.0.0.1
